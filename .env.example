# OpenRouter API Key & Base URL
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model fallback (used if specific model is not specified)
DEFAULT_MODEL=openai/gpt-4o-mini

# Specific OpenRouter models for each component/part of MAGI:
# Initial question classifier (Is it a yes/no question?)
MODEL_IS_YES_OR_NO=google/gemma-2-9b-it:free

# MAGI Agents (Melchior, Balthasar, Casper)
MODEL_MELCHIOR=google/gemma-2-9b-it:free
MODEL_BALTHASAR=openai/gpt-4o-mini
MODEL_CASPER=meta-llama/llama-3.3-70b-instruct:free

# Final classification/summary model
MODEL_CLASSIFY=openai/gpt-4o-mini

# Optional Speech-To-Text (Whisper) configuration
STT_API_KEY=your_openai_api_key_for_whisper_here
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
# Language hint for transcription ('auto' lets Whisper detect it)
STT_LANGUAGE=es
